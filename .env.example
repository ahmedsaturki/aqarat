# Local/server runtime. Never commit real secret values.
PORT=8787
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
TELEGRAM_WEBHOOK_SECRET=<random-secret>
TELEGRAM_ADMIN_STATUS_SECRET=<admin-only-secret>
INTAKE_WEBHOOK_SECRET=<server-only-secret>
JOB_RUNNER_SECRET=<server-only-secret>
GOOGLE_SHEETS_WEBHOOK_URL=<google-apps-script-web-app-url>
GOOGLE_SHEETS_WEBHOOK_SECRET=<random-secret>
PUBLIC_BASE_URL=https://aqarat-eg.vercel.app
PUBLIC_MARKETING_BRAND=لارا للتسويق العقاري
PUBLIC_MARKETING_PHONE=<lara-public-phone>
PUBLIC_MARKETING_WHATSAPP=<lara-public-whatsapp>
PUBLIC_MARKETING_WEBSITE=<lara-public-website>
GEMINI_API_KEY=<server-only-secret>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Deep health uses a quota-safe model metadata probe by default; use generation only for explicit diagnostics.
GEMINI_HEALTH_PROBE=metadata
AI_DISCOVERY_TIMEOUT_MS=20000
DASHBOARD_ADMIN_SECRET=<operator-only-secret>
# Bounded request and outbound-call safety limits.
MAX_BODY_BYTES=262144
OUTBOUND_TIMEOUT_MS=15000

# GitHub Actions verification variables (not required by the application runtime).
# AQARAT_RELEASE_URL=https://aqarat-eg.vercel.app
# EXPECTED_GIT_SHA=<optional-expected-production-commit>
